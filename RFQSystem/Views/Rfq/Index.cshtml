@model List<Rfq>
@inject MockDb Db
@{
    ViewData["Title"] = "詢價單";
    var current = ViewBag.Status as RfqStatus?;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">詢價單</h3>
    <a class="btn btn-primary" asp-action="Create">＋ 新增詢價單</a>
</div>

<div class="card p-3 mb-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-auto">
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">全部狀態</option>
                @foreach (var s in Enum.GetValues<RfqStatus>())
                {
                    <option value="@s" selected="@(current == s)">@s.Text()</option>
                }
            </select>
        </div>
        <div class="col-auto"><input name="q" value="@ViewBag.Q" class="form-control form-control-sm" placeholder="搜尋單號或主旨" /></div>
        <div class="col-auto"><button class="btn btn-sm btn-outline-secondary">搜尋</button></div>
    </form>
</div>

<div class="card p-0">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr><th>單號</th><th>主旨</th><th>需求部門</th><th>採購</th><th>狀態</th><th class="num">項目數</th><th class="num">報價家數</th><th class="num">目標總額</th><th class="num">決標金額</th><th>截止日</th></tr>
        </thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@r.Id">@r.No</a></td>
                <td>@r.Title</td>
                <td>@r.Department</td>
                <td>@r.Buyer</td>
                <td>
                    <span class="badge bg-@r.Status.Badge()">@r.Status.Text()</span>
                    @if (r.IsSealed && r.Status == RfqStatus.Quoting) { <span class="badge bg-dark">@(Db.CanOpen(r).Ok ? "可開標" : "密封")</span> }
                </td>
                <td class="num">@r.Lines.Count</td>
                <td class="num">@r.Quotes.Select(q => q.SupplierId).Distinct().Count() / @r.InvitedSupplierIds.Count</td>
                <td class="num">@r.TargetTotal.ToString("N0")</td>
                <td class="num">@(r.Awards.Count > 0 ? r.AwardTotal.ToString("N0") : "-")</td>
                <td>@r.Deadline.ToString("yyyy/MM/dd")</td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="10" class="text-center text-muted py-4">沒有符合條件的詢價單</td></tr>
        }
        </tbody>
    </table>
</div>
