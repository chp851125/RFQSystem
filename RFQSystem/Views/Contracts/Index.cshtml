@model List<PriceContract>
@{
    ViewData["Title"] = "合約價";
    var db = (MockDb)ViewBag.Db;
    var status = ViewBag.Status as string;
    var all = db.Contracts;
    var yearSpend = db.PurchaseOrders.Where(p => p.ContractId != null && p.CreatedAt.Year == DateTime.Today.Year).Sum(p => p.Total);
    var statuses = new[] { "生效中", "即將到期", "未生效", "已到期", "已終止" };
}
<h3>合約價管理</h3>
<div class="help mb-3">
    <strong>合約價（Price Agreement）</strong>是與供應商約定「一段期間內、固定價格」的協議，通常由年度詢價決標而來。
    合約有效期間內需要這個料件時，可直接<strong>依合約下單</strong>，不必每次重新詢比議價，節省作業時間。
    合約到期前 @PriceContract.ExpiringDays 天會列為「即將到期」，提醒採購進行續約詢價。
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3"><div class="card kpi p-3"><div class="label">生效中合約</div><div class="value text-success">@all.Count(c => c.IsActive)</div></div></div>
    <div class="col-6 col-md-3"><div class="card kpi p-3"><div class="label">@PriceContract.ExpiringDays 天內到期</div><div class="value text-warning">@all.Count(c => c.Status == "即將到期")</div></div></div>
    <div class="col-6 col-md-3"><div class="card kpi p-3"><div class="label">今年依合約下單金額</div><div class="value">@yearSpend.ToString("N0")</div></div></div>
    <div class="col-6 col-md-3"><div class="card kpi p-3"><div class="label">合約涵蓋料件</div><div class="value">@all.Where(c => c.IsActive).Select(c => c.MaterialId).Distinct().Count() / @db.Materials.Count</div></div></div>
</div>

<div class="card p-3 mb-3">
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-sm @(status == null ? "btn-primary" : "btn-outline-secondary")">全部 @all.Count</a>
        @foreach (var s in statuses)
        {
            <a asp-action="Index" asp-route-status="@s" class="btn btn-sm @(status == s ? "btn-primary" : "btn-outline-secondary")">@s @all.Count(c => c.Status == s)</a>
        }
    </div>
</div>

<div class="card p-0">
    <div class="table-responsive">
    <table class="table table-hover mb-0">
        <thead class="table-light"><tr><th>合約編號</th><th>料件</th><th>供應商</th><th class="num">合約單價</th><th>有效期間</th><th>狀態</th><th style="width:170px">承諾量使用</th><th>來源</th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
            var m = db.Material(c.MaterialId);
            var used = db.ContractUsed(c);
            var pct = c.CommittedQty > 0 ? (int)Math.Min(100, used / c.CommittedQty * 100) : 0;
            <tr class="@(c.Status == "即將到期" ? "table-warning" : "")">
                <td><a asp-action="Details" asp-route-id="@c.Id">@c.No</a></td>
                <td>@m.PartNo @m.Name</td>
                <td>@db.Supplier(c.SupplierId).Name</td>
                <td class="num">@c.UnitPrice.ToString("N2")@if (c.Tiers.Count > 0) { <div class="small text-primary">階梯 @c.Tiers.Count 段</div> }</td>
                <td class="small">@c.ValidFrom.ToString("yyyy/MM/dd") ~ @c.ValidTo.ToString("yyyy/MM/dd")
                    @if (c.IsActive) { <div class="text-muted">剩 @c.DaysLeft 天</div> }</td>
                <td><span class="badge bg-@c.StatusBadge">@c.Status</span></td>
                <td>
                    @if (c.CommittedQty > 0)
                    {
                        <div class="progress" style="height:8px"><div class="progress-bar @(used > c.CommittedQty ? "bg-danger" : "")" style="width:@(pct)%"></div></div>
                        <div class="small text-muted">@used.ToString("N0") / @c.CommittedQty.ToString("N0") @m.Unit（@(pct)%）</div>
                    }
                    else { <span class="small text-muted">無承諾量</span> }
                </td>
                <td class="small">@if (c.SourceRfqId is int rid) { <a asp-controller="Rfq" asp-action="Details" asp-route-id="@rid">@db.FindRfq(rid)?.No</a> } else { <span class="text-muted">年度議價</span> }</td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-4">沒有符合條件的合約</td></tr> }
        </tbody>
    </table>
    </div>
</div>
