@model List<PurchaseOrder>
@{
    ViewData["Title"] = "我的採購單";
    var db = (MockDb)ViewBag.Db;
}
<h3>我的採購單</h3>
<div class="help mb-3">收到採購單後請「確認接單」，代表貴司同意單價、數量與交期。實務上之後還會在平台上回覆出貨、上傳發票與查詢付款進度。</div>
@foreach (var po in Model)
{
    var r = db.FindRfq(po.RfqId);
    var ct = po.ContractId.HasValue ? db.FindContract(po.ContractId.Value) : null;
    <div class="card p-3 mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
            <div>
                <strong class="fs-5">@po.No</strong>
                <span class="badge bg-@(po.Status == "已發出" ? "danger" : "success")">@(po.Status == "已發出" ? "待確認" : po.Status)</span>
                <div class="small text-muted">開立 @po.CreatedAt.ToString("yyyy/MM/dd") ・ 來源 @(r?.No ?? (ct != null ? "合約 " + ct.No : "")) ・ 付款條件 @po.PaymentTerms ・ 交貨地點 @po.DeliveryPlace
                    @if (po.ConfirmedAt.HasValue) { <span>・ 確認於 @po.ConfirmedAt.Value.ToString("yyyy/MM/dd HH:mm")</span> }</div>
            </div>
            @if (po.Status == "已發出")
            {
                <form asp-action="ConfirmPo" method="post"><input type="hidden" name="poId" value="@po.Id" /><button class="btn btn-success">確認接單</button></form>
            }
        </div>
        <table class="table table-sm mb-0">
            <thead class="table-light"><tr><th>料號</th><th>品名</th><th class="num">數量</th><th class="num">單價</th><th class="num">金額</th><th>交貨日</th></tr></thead>
            <tbody>
            @foreach (var l in po.Lines)
            {
                var m = db.Material(l.MaterialId);
                <tr><td>@m.PartNo</td><td>@m.Name</td><td class="num">@l.Qty.ToString("N0") @m.Unit</td><td class="num">@l.UnitPrice.ToString("N2")</td><td class="num">@((l.Qty * l.UnitPrice).ToString("N0"))</td><td>@l.DeliveryDate.ToString("yyyy/MM/dd")</td></tr>
            }
            </tbody>
            <tfoot><tr><th colspan="4" class="num">未稅合計</th><th class="num">@po.Total.ToString("N0")</th><th></th></tr></tfoot>
        </table>
    </div>
}
@if (Model.Count == 0) { <div class="text-muted">目前沒有採購單。</div> }
