@model MockDb
@{
    var m = Model.Material((int)ViewBag.Id);
    ViewData["Title"] = m.PartNo;
    var h = Model.PriceHistories.Where(x => x.MaterialId == m.Id).OrderBy(x => x.Date).ToList();
    var max = h.Count == 0 ? 1 : h.Max(x => x.UnitPrice);
    var min = h.Count == 0 ? 0 : h.Min(x => x.UnitPrice);
    var rfqs = Model.Rfqs.Where(r => r.Lines.Any(l => l.MaterialId == m.Id)).ToList();
    // 簡易折線圖（SVG）座標
    const int W = 700, H = 200, P = 30;
    var pts = h.Select((x, i) => (
        X: h.Count < 2 ? W / 2.0 : P + i * (W - 2.0 * P) / (h.Count - 1),
        Y: H - P - (max == min ? (H - 2.0 * P) / 2 : (double)((x.UnitPrice - min) / (max - min)) * (H - 2 * P)))).ToList();
}
<a asp-action="Index" class="small">← 料件列表</a>
<h3>@m.PartNo @m.Name</h3>
<div class="text-muted mb-3">@m.Spec ・ 單位 @m.Unit ・ 分類 @m.Category</div>

<div class="card p-3 mb-3">
    <h6>價格趨勢</h6>
    @if (h.Count >= 2)
    {
        <svg viewBox="0 0 @W @H" style="width:100%;max-width:@(W)px">
            <line x1="@P" y1="@(H - P)" x2="@(W - P)" y2="@(H - P)" stroke="#ccc" />
            <polyline fill="none" stroke="#0d6efd" stroke-width="2" points="@string.Join(" ", pts.Select(p => $"{p.X:0},{p.Y:0}"))" />
            @for (var i = 0; i < h.Count; i++)
            {
                <circle cx="@pts[i].X.ToString("0")" cy="@pts[i].Y.ToString("0")" r="4" fill="#0d6efd"><title>@h[i].Date.ToString("yyyy/MM/dd")：@h[i].UnitPrice.ToString("N2")</title></circle>
                @Html.Raw($"<text x=\"{pts[i].X:0}\" y=\"{pts[i].Y - 8:0}\" font-size=\"11\" text-anchor=\"middle\" fill=\"#555\">{h[i].UnitPrice:0.#}</text>")
                @Html.Raw($"<text x=\"{pts[i].X:0}\" y=\"{H - 10}\" font-size=\"10\" text-anchor=\"middle\" fill=\"#999\">{h[i].Date:yy/MM}</text>")
            }
        </svg>
    }
    else { <div class="text-muted">歷史資料不足</div> }
</div>

<div class="row g-3">
    <div class="col-lg-7"><div class="card p-3">
        <h6>歷史成交紀錄</h6>
        <table class="table table-sm mb-0">
            <thead class="table-light"><tr><th>日期</th><th>供應商</th><th class="num">數量</th><th class="num">單價</th><th>來源</th></tr></thead>
            <tbody>
            @foreach (var x in h.AsEnumerable().Reverse())
            {
                <tr><td>@x.Date.ToString("yyyy/MM/dd")</td><td>@Model.Supplier(x.SupplierId).Name</td><td class="num">@x.Qty.ToString("N0")</td><td class="num">@x.UnitPrice.ToString("N2")</td><td>@x.Source</td></tr>
            }
            </tbody>
        </table>
    </div></div>
    <div class="col-lg-5"><div class="card p-3">
        <h6>相關詢價單</h6>
        @foreach (var r in rfqs)
        {
            <div class="d-flex justify-content-between border-bottom py-1">
                <a asp-controller="Rfq" asp-action="Details" asp-route-id="@r.Id">@r.No @r.Title</a>
                <span class="badge bg-@r.Status.Badge()">@r.Status.Text()</span>
            </div>
        }
        @if (rfqs.Count == 0) { <div class="text-muted small">無</div> }
    </div></div>
</div>
